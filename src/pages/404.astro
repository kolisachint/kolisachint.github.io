---
import BaseLayout from "../layouts/BaseLayout.astro";
import Mark from "../components/Mark.astro";
---

<BaseLayout title="Not found" description="That page does not exist.">
  <section class="shell wrap">
    <Mark size={44} />
    <p class="code mono">404</p>
    <h1>Nothing here.</h1>
    <p class="sub">
      The page moved, or never existed. Neither is your fault.
    </p>
    <nav class="links" aria-label="Somewhere that exists">
      <a class="btn primary" href="/">Home</a>
      <a class="btn" href="/work">Work</a>
      <a class="btn" href="/hoocode">HooCode docs</a>
    </nav>
  </section>
</BaseLayout>

<style>
  .wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding-block: var(--space-32) var(--space-24);
  }

  .code {
    color: var(--text-3);
    letter-spacing: var(--tracking-label);
  }

  h1 {
    font-size: var(--text-2xl);
  }

  .sub {
    color: var(--text-3);
    max-width: var(--measure-narrow);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
</style>
