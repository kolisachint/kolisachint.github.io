---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import {
  site,
  headlines,
  background,
  recognition,
  profiles,
  email,
} from "../site";

const canonical = new URL("/about", Astro.site).href;

/**
 * Structured data is how a recruiter's tooling — and Google — reads this page.
 * It is the reason the visible copy can stay short: the machine-readable part
 * carries the identifiers, the human part carries the voice.
 */
const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  url: new URL("/", Astro.site).href,
  mainEntityOfPage: canonical,
  jobTitle: "Solution Architect",
  description: site.description,
  /* No `worksFor`. The visible page names no employer, and structured data
     that says more than the page does is a back door, not a feature. */
  knowsAbout: [
    "Google Cloud Platform",
    "BigQuery",
    "Data platform architecture",
    "Data warehouse migration",
    "Rust",
    "TypeScript",
    "Coding agent tooling",
  ],
  sameAs: profiles.map((p) => p.url),
};
---

<BaseLayout
  title="About"
  description="Solution architect working on cloud data platforms, and the author of small open-source tools for coding agents. Eighteen years in enterprise data."
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(personLd)}
  />

  <header class="page-head">
    <div class="shell" data-hero>
      <p class="label">About</p>
      <h1>{headlines.about}</h1>
    </div>
  </header>

  <Section eyebrow="In short">
    <div class="prose lede-prose" data-reveal>
      <p>
        Hello. I'm Sachin — a solution architect, which mostly means I design
        the layer nobody sees: the pipelines and platforms that decide whether
        an app shows you the right number.
      </p>
      <p>
        {background.sentence} The interesting problem is rarely the algorithm.
        It is almost always the migration — moving something that cannot stop,
        without stopping it — which is why I'm relaxed about legacy systems and
        suspicious of rewrites.
      </p>
      <p>
        I don't write about that work here. It belongs to the people who paid
        for it, and the parts I could describe would not tell you much anyway.
        What I can show you is the code I write in the open, which comes from
        exactly the same place: every tool on the{" "}
        <a class="link" href="/work">work page</a> exists because the one I
        needed was missing, too slow, or too eager to guess. They are small on
        purpose, and I would rather you read them than take my word for any of
        it.
      </p>
      <p>
        If you found your way here from a repository or an npm page — welcome,
        and thank you for being curious. Ask me anything about any of it.
      </p>
    </div>
  </Section>

  <Section eyebrow="Contact" tight>
    <div class="prose">
      <p>
        Email is the best way to reach me. A question about one of the tools, a
        bug, a disagreement, or just an introduction — all equally welcome, and
        none of them need an excuse.
      </p>
    </div>

    {/* Email only. The same five profile links sit a hundred pixels below
        this, in the footer, on every page of the site. */}
    <p class="mail" data-reveal>
      <a
        class="link"
        id="about-mail"
        href="#"
        data-u={email.user}
        data-d={email.domain}
      >
        <span class="mono"
          >{email.user}<span aria-hidden="true">&#64;</span>{email.domain}</span
        >
      </a>
    </p>

    {/* One line, at the very bottom, in the small grey. The awards are public
        record and worth stating once; a section of their own turned them into
        a trophy cabinet. */}
    <p class="recognition mono" data-reveal>
      Work I architected was recognised at the {
        recognition.map((r, i) => (
          <>
            {i > 0 && (i === recognition.length - 1 ? " and the " : ", ")}
            {r.award} {r.year}
          </>
        ))
      }.
    </p>
  </Section>
</BaseLayout>

<style>
  .page-head {
    padding-block: var(--space-16) var(--space-8);
  }

  .page-head .label {
    margin-bottom: var(--space-6);
  }

  .page-head h1 {
    max-width: 20ch;
  }

  .lede-prose {
    color: var(--text-2);
    font-size: var(--text-lg);
  }

  /* Deliberately quiet: the smallest type on the page, in the dimmest grey,
     no accent and no border. It is a fact the page states once, not a claim
     the page is built around. */
  .recognition {
    max-width: var(--measure);
    margin-top: var(--space-10);
    font-size: var(--text-xs);
    color: var(--text-3);
  }

  .mail {
    margin: var(--space-8) 0 0;
    font-size: var(--text-lg);
  }
</style>

<script>
  const a = document.getElementById("about-mail") as HTMLAnchorElement | null;
  if (a?.dataset.u && a.dataset.d) {
    a.href = `mailto:${a.dataset.u}@${a.dataset.d}`;
  }
</script>
