---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import {
  site,
  headlines,
  career,
  recognition,
  profiles,
  email,
} from "../site";

const canonical = new URL("/about", Astro.site).href;

/**
 * Structured data is how a recruiter's tooling — and Google — reads this page.
 * It is the reason the visible copy can stay short: the machine-readable part
 * carries the identifiers, the human part carries the voice.
 */
const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  url: new URL("/", Astro.site).href,
  mainEntityOfPage: canonical,
  jobTitle: "Solution Architect",
  description: site.description,
  /* Says no more than the visible page does: structured data that goes
     further is a back door, not a feature. */
  worksFor: { "@type": "Organization", name: career.employer },
  knowsAbout: [
    "Google Cloud Platform",
    "BigQuery",
    "Data platform architecture",
    "Data warehouse migration",
    "Rust",
    "TypeScript",
    "Coding agent tooling",
  ],
  sameAs: profiles.map((p) => p.url),
};
---

<BaseLayout
  title="About"
  description="Solution architect for cloud data & AI platforms at Tata Consultancy Services, in data since 2008, and the author of small open-source tools for coding agents."
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(personLd)}
  />

  <header class="page-head">
    <div class="shell head-grid" data-hero>
      <div>
        <p class="label">About</p>
        <h1>{headlines.about}</h1>
      </div>
      <img
        class="portrait"
        src="/img/sachin-koli.webp"
        alt={`Illustrated portrait of ${site.name} in wire glasses and a navy blazer, on a teal background`}
        width="160"
        height="160"
        decoding="async"
      />
    </div>
  </header>

  {/* Short and scannable, 2026-10-22: three short paragraphs and a way to
      reach me. Who, the day job in two sentences, the open-source work. The
      full story is on LinkedIn. */}
  <Section eyebrow="In short">
    <div class="prose lede-prose" data-reveal>
      <p>
        Hello, I'm Sachin, a solution architect in Pune. I design the data
        platforms nobody sees: the pipelines that decide whether an app shows
        you the right number.
      </p>
      <p>
        Right now I'm at {career.employer}, architecting {career.current}.{" "}
        {career.earlier}
      </p>
      <p>
        The rest of the time I build small open-source tools for coding agents,
        each because the one I needed was missing, too slow, or too eager to
        guess. They are on the <a class="link" href="/work">work page</a>. If
        you came here from one of them, welcome.
      </p>
    </div>
  </Section>

  <Section eyebrow="Contact" tight>
    <p class="mail" data-reveal>
      Questions, bugs or just hello:{" "}
      <a
        class="link"
        id="about-mail"
        href="#"
        data-u={email.user}
        data-d={email.domain}
      >
        <span class="mono"
          >{email.user}<span aria-hidden="true">&#64;</span>{email.domain}</span
        >
      </a>
    </p>

    {/* One line, at the very bottom, in the small grey. The awards are public
        record and worth stating once; a section of their own turned them into
        a trophy cabinet. */}
    <p class="recognition mono" data-reveal>
      Work I architected was recognised at the {
        recognition.map((r, i) => (
          <>
            {i > 0 && (i === recognition.length - 1 ? " and the " : ", ")}
            {r.award} {r.year}
          </>
        ))
      }.
    </p>
  </Section>
</BaseLayout>

<style>
  .page-head {
    padding-block: var(--space-16) var(--space-8);
  }

  /* Same portrait as the home hero, smaller. Leads on a phone, as a profile
     picture does; sits opposite the headline once there is room. */
  .head-grid {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  .portrait {
    order: -1;
    width: clamp(88px, 18vw, 160px);
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--hoo-r-card);
    border: 1px solid var(--border);
  }

  @media (min-width: 52rem) {
    .head-grid {
      grid-template-columns: 1fr auto;
      gap: var(--space-16);
    }
    .portrait {
      order: 0;
    }
  }

  .page-head .label {
    margin-bottom: var(--space-6);
  }

  .page-head h1 {
    max-width: 20ch;
  }

  .lede-prose {
    color: var(--text-2);
    font-size: var(--text-lg);
  }

  /* Deliberately quiet: the smallest type on the page, in the dimmest grey,
     no accent and no border. It is a fact the page states once, not a claim
     the page is built around. */
  .recognition {
    max-width: var(--measure);
    margin-top: var(--space-10);
    font-size: var(--text-xs);
    color: var(--text-3);
  }

  .mail {
    margin: 0;
    font-size: var(--text-lg);
  }
</style>

<script>
  const a = document.getElementById("about-mail") as HTMLAnchorElement | null;
  if (a?.dataset.u && a.dataset.d) {
    a.href = `mailto:${a.dataset.u}@${a.dataset.d}`;
  }
</script>
