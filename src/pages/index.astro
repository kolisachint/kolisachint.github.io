---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import PinCard from "../components/PinCard.astro";
import { site, headlines, career, profiles } from "../site";
import { pinned } from "../lib/pinned";

const x = profiles.find((p) => p.name === "X")!;

/* Structured data is how a recruiter's tooling reads the page. It says no more
   than the visible page does. Moved here from /about, which no longer exists. */
const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  url: new URL("/", Astro.site).href,
  jobTitle: "Solution Architect",
  description: site.description,
  knowsAbout: [
    "Cloud data platforms",
    "Data architecture",
    "Rust",
    "TypeScript",
    "Coding agent tooling",
  ],
  sameAs: profiles.map((p) => p.url),
};

/* Short and scannable: face, name, who, what, a short bio, then the projects.
   The projects are the GitHub pinned repos, fetched at build time into
   src/data/pinned.json, so nothing here is edited when the pins change. */
---

<!-- Written out rather than composed: site.role already carries an em dash,
     and two of them in one <title> reads as a mistake. -->
<BaseLayout
  title={`${site.name} — solution architect, cloud data & AI platforms`}
  suffix={false}
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(personLd)}
  />

  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-text" data-hero>
        <p class="hello">Hi, I'm {site.name}.</p>
        <h1>{headlines.home}</h1>
        <p class="sub">{headlines.homeSub}</p>
        <p class="role mono">{site.role}</p>
        <p class="meta mono">{career.meta}</p>
      </div>

      <div class="hero-portrait">
        <img
          src="/img/sachin-koli.webp"
          alt={`Illustrated portrait of ${site.name} in wire glasses and a navy blazer, on a teal background`}
          width="220"
          height="220"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <Section eyebrow="About">
    <div class="prose bio" data-reveal>
      <p>
        I'm a solution architect. I design the data platforms nobody sees:
        the pipelines that decide whether an app shows you the right number.
        These days that means batch and real-time platforms in the cloud.
      </p>
      <p>
        The rest of the time I build small open-source tools for coding agents,
        each because the one I needed was missing, too slow, or too eager to
        guess. If you came here from one of them, welcome.
      </p>
    </div>
  </Section>

  <Section eyebrow="Projects">
    <h2 class="sec-title" data-reveal>What I'm building now</h2>

    <div class="cards">
      {pinned.map((repo, i) => (
        <div class="card-wrap" data-reveal style={`--reveal-delay:${i * 60}ms`}>
          <PinCard repo={repo} />
        </div>
      ))}
    </div>
  </Section>

  <Section eyebrow="Contact" tight>
    <p class="mail" data-reveal>
      Questions about any of it are welcome:{" "}
      <a class="link" href={x.url} rel="me">
        <span class="mono">X {x.handle}</span>
      </a>
    </p>
  </Section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding-block: clamp(var(--space-12), 8vh, var(--space-20))
      var(--space-12);
  }

  /* No glow orb here, and no node on the portrait either. Cyan is emphasis,
     not atmosphere; the section spine's node below is this page's one cyan
     moment. */

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  .hello {
    margin-bottom: var(--space-4);
    font-size: var(--text-lg);
    color: var(--text-2);
  }

  .hero h1 {
    max-width: 18ch;
  }

  .sub {
    margin-top: var(--space-4);
    font-size: var(--text-lg);
    color: var(--text-3);
    max-width: var(--measure-narrow);
  }

  .role {
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-3);
  }

  .meta {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-3);
  }

  /* Portrait. Present, not dominant — the work is the headline. */
  .hero-portrait {
    position: relative;
    width: fit-content;
    justify-self: start;
  }

  .hero-portrait img {
    width: clamp(112px, 22vw, 220px);
    height: clamp(112px, 22vw, 220px);
    object-fit: cover;
    border-radius: var(--hoo-r-card);
    border: 1px solid var(--border);
  }

  /* An illustrated portrait on flat teal, shown in colour. It is imagery, not
     interface colour: cyan is still the only accent. */

  /* Below 52rem it leads, as a profile picture does. Above, it sits opposite
     the headline and the DOM order is the reading order again. */
  .hero-portrait {
    order: -1;
  }

  @media (min-width: 52rem) {
    .hero-grid {
      grid-template-columns: 1fr auto;
      gap: var(--space-16);
    }
    .hero-portrait {
      order: 0;
      justify-self: end;
    }
  }

  .sec-title {
    margin-bottom: var(--space-8);
  }

  .mail {
    margin: 0;
    font-size: var(--text-lg);
  }

  .bio {
    color: var(--text-2);
    font-size: var(--text-lg);
  }

  /* One column, then two. Never auto-fit: four cards in a three-wide row
     leave one stranded. */
  .cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 52rem) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .card-wrap {
    min-width: 0;
  }

  .card-wrap :global(.card) {
    height: 100%;
  }

</style>

