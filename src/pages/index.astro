---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { site, headlines, email, now } from "../site";

const projects = (await getCollection("projects"))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

/* Four entries, and four is the whole set. The slice stays so that adding a
   fifth markdown file does not silently change this page's shape. */
const featured = projects.slice(0, 4);

/* The band under the hero used to be four statistics — years, employers,
   awards, current engagement. It read as a scoreboard, which is the wrong
   first impression for a personal site, and three of the four facts described
   work that is not public.

   What replaces it is a set of directions. A visitor arriving from a README
   wants the code; one arriving from a search wants to know who wrote it. Each
   card says where it goes and what is there, so neither has to guess. */
const signposts = [
  {
    label: "The tools",
    href: "/work",
    title: "Four things I build in the open",
    note: "A coding agent, and the Rust it leans on.",
  },
  {
    label: "The docs",
    href: "/hoocode",
    title: "HooCode, documented in full",
    note: "The same pages that ship with the package.",
  },
  {
    label: "The person",
    href: "/about",
    title: "How I ended up here",
    note: "Eighteen years of data, and what changed.",
  },
];
---

<!-- Written out rather than composed: site.role already carries an em dash,
     and two of them in one <title> reads as a mistake. -->
<BaseLayout
  title={`${site.name} — solution architect, cloud data platforms`}
  suffix={false}
>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-text" data-hero>
        <p class="label">{site.role}</p>
        <h1>{headlines.home}</h1>
        <p class="sub">{headlines.homeSub}</p>

        <div class="actions">
          <a class="btn primary" href="/work">See the tools</a>
          <a class="btn" href="/about">About me</a>
        </div>
      </div>

      <div class="hero-portrait">
        <img
          src="/img/sachin-koli.jpg"
          alt={site.name}
          width="220"
          height="220"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- Directions, not statistics. See the note in the frontmatter. -->
  <section class="record">
    <div class="shell">
      <h2 class="visually-hidden">Where to start</h2>
      <nav class="record-grid" aria-label="Where to start">
        {
          signposts.map((s, i) => (
            <a
              class="fact"
              href={s.href}
              data-reveal
              style={`--reveal-delay:${i * 60}ms`}
            >
              <span class="label">{s.label}</span>
              <span class="fact-value">
                {s.title}
                <span class="arrow" aria-hidden="true">→</span>
              </span>
              <span class="fact-note mono">{s.note}</span>
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <Section eyebrow="Now" tight>
    <p class="now" data-reveal>{now.text}</p>
    <p class="now-stamp mono" data-reveal>Updated {now.updated}</p>
  </Section>

  <Section eyebrow="In the open">
    <div class="sec-head" data-reveal>
      <h2>Things I build in the open</h2>
      <p class="lede">
        Four of them. One terminal coding agent in TypeScript, and three small
        Rust binaries it leans on. Each does a single thing, all of it is free
        to read, and none of it needs my permission to use.
      </p>
    </div>

    <div class="cards">
      {featured.map((project, i) => (
        <div class="card-wrap" data-reveal style={`--reveal-delay:${i * 60}ms`}>
          <ProjectCard project={project} />
        </div>
      ))}
    </div>

    <p class="more" data-reveal>
      <a class="link" href="/work">Why each one exists &rarr;</a>
    </p>
  </Section>

  <Section eyebrow="Contact" tight>
    <div class="sec-head" data-reveal>
      <h2>Say hello</h2>
      <p class="lede">
        Email is the best way to reach me — about the tools, the data work, or
        something you are stuck on. I read everything.
      </p>
    </div>

    <!-- Email only. The same five profile links sat a hundred pixels below
         this list, in the footer, on every page. -->
    <p class="mail" data-reveal>
      <a class="link" id="hero-mail" href="#" data-u={email.user} data-d={email.domain}>
        <span class="mono">{email.user}<span aria-hidden="true">&#64;</span>{email.domain}</span>
      </a>
    </p>
  </Section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding-block: clamp(var(--space-16), 12vh, var(--space-32))
      var(--space-16);
  }

  /* No glow orb here, and no node on the portrait either. Cyan is emphasis,
     not atmosphere: in a real 1440x900 viewport the portrait node, the primary
     button and the masthead's current-page dot were all lit at once. The
     button is the one this viewport keeps. */

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  .hero-text > .label {
    margin-bottom: var(--space-6);
  }

  .hero h1 {
    max-width: 18ch;
  }

  .sub {
    margin-top: var(--space-6);
    font-size: var(--text-lg);
    color: var(--text-3);
    max-width: var(--measure-narrow);
  }

  /* Buttons are global now — see .btn in global.css. */
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  /* Portrait. Present, not dominant — the work is the headline. */
  .hero-portrait {
    position: relative;
    width: fit-content;
    justify-self: start;
  }

  .hero-portrait img {
    /* 96px at 390 — a portrait, not the orphaned square that used to sit
       alone between the buttons and the spine. */
    width: clamp(96px, 22vw, 220px);
    height: clamp(96px, 22vw, 220px);
    object-fit: cover;
    border-radius: var(--hoo-r-card);
    border: 1px solid var(--border);
    filter: grayscale(1) contrast(1.02);
    transition: filter 420ms var(--ease);
  }

  .hero-portrait:hover img {
    filter: grayscale(0) contrast(1);
  }

  /* Below 52rem it leads, as a profile picture does. Above, it sits opposite
     the headline and the DOM order is the reading order again. */
  .hero-portrait {
    order: -1;
  }

  @media (min-width: 52rem) {
    .hero-grid {
      grid-template-columns: 1fr auto;
      gap: var(--space-16);
    }
    .hero-portrait {
      order: 0;
      justify-self: end;
    }
  }

  /* -- Record band ------------------------------------------------------ */

  .record .shell {
    padding-block: var(--space-8);
    border-block: 1px solid var(--border);
  }

  /* Subgrid, so a value that wraps to two lines does not push its own note
     out of line with the other three. Label, value, note are three shared
     rows, not three independent stacks. */
  .record-grid {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: auto;
    gap: var(--space-6) var(--space-8);
  }

  .fact {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-2);
    transition: color var(--dur) var(--ease);
  }

  .fact-value {
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--text-2);
    text-wrap: balance;
    transition: color var(--dur) var(--ease);
  }

  .fact-note {
    font-size: var(--text-xs);
    color: var(--text-3);
    align-self: end;
  }

  /* They are links now, so they have to look clickable without becoming three
     more boxes on a page already made of boxes. A dim arrow at rest, brighter
     and nudged on hover. Nothing lights up cyan — the hero button already owns
     that in this viewport. */
  .arrow {
    display: inline-block;
    margin-left: 0.15em;
    color: var(--text-3);
    transition:
      transform var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .fact:hover .fact-value {
    color: var(--text);
  }

  .fact:hover .arrow {
    color: var(--accent-ink);
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .arrow {
      transition: color var(--dur) var(--ease);
    }

    .fact:hover .arrow {
      transform: none;
    }
  }

  /* One column, then three. Never two — three items in a two-column row wrap
     to 2 + 1 and read as a mistake. */
  @media (min-width: 46rem) {
    .record-grid {
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: auto 1fr auto;
    }

    .fact {
      grid-row: span 3;
      grid-template-rows: subgrid;
    }
  }

  .now {
    font-size: var(--text-lg);
    color: var(--text-2);
    max-width: var(--measure);
  }

  .now-stamp {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--text-3);
  }

  .sec-head {
    max-width: var(--measure);
    margin-bottom: var(--space-8);
  }

  .lede {
    margin-top: var(--space-4);
    color: var(--text-3);
  }

  .mail {
    margin: 0;
    font-size: var(--text-lg);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--card-min)), 1fr));
    gap: var(--space-4);
  }

  .card-wrap {
    min-width: 0;
  }

  .card-wrap :global(.card) {
    height: 100%;
  }

  .more {
    margin-top: var(--space-8);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
</style>

<script>
  const a = document.getElementById("hero-mail") as HTMLAnchorElement | null;
  if (a?.dataset.u && a.dataset.d) {
    a.href = `mailto:${a.dataset.u}@${a.dataset.d}`;
  }
</script>
