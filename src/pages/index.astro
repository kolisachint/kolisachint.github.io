---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { site, headlines, email, career } from "../site";

const projects = (await getCollection("projects"))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

/* Four entries, and four is the whole set. The slice stays so that adding a
   fifth markdown file does not silently change this page's shape. */
const featured = projects.slice(0, 4);

/* Short and scannable, 2026-10-22. A visitor should have it in about ten
   seconds: face, name, who, what, then the projects. The signpost band, the
   "Now" paragraph and the section ledes were cut; the masthead already links
   every page, and the project cards say what each tool is for. */
---

<!-- Written out rather than composed: site.role already carries an em dash,
     and two of them in one <title> reads as a mistake. -->
<BaseLayout
  title={`${site.name} — solution architect, cloud data & AI platforms`}
  suffix={false}
>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-text" data-hero>
        <p class="hello">Hi, I'm {site.name}.</p>
        <h1>{headlines.home}</h1>
        <p class="sub">{headlines.homeSub}</p>
        <p class="role mono">{site.role}</p>
        <p class="meta mono">{career.meta}</p>
      </div>

      <div class="hero-portrait">
        <img
          src="/img/sachin-koli.webp"
          alt={`Illustrated portrait of ${site.name} in wire glasses and a navy blazer, on a teal background`}
          width="220"
          height="220"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <Section eyebrow="Projects">
    <h2 class="sec-title" data-reveal>What I'm building now</h2>

    <div class="cards">
      {featured.map((project, i) => (
        <div class="card-wrap" data-reveal style={`--reveal-delay:${i * 60}ms`}>
          <ProjectCard project={project} />
        </div>
      ))}
    </div>

    <p class="more" data-reveal>
      <a class="link" href="/work">More on the work page &rarr;</a>
    </p>
  </Section>

  <Section eyebrow="Contact" tight>
    <p class="mail" data-reveal>
      Questions about any of it are welcome:{" "}
      <a class="link" id="hero-mail" href="#" data-u={email.user} data-d={email.domain}>
        <span class="mono">{email.user}<span aria-hidden="true">&#64;</span>{email.domain}</span>
      </a>
    </p>
  </Section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding-block: clamp(var(--space-12), 8vh, var(--space-20))
      var(--space-12);
  }

  /* No glow orb here, and no node on the portrait either. Cyan is emphasis,
     not atmosphere; the section spine's node below is this page's one cyan
     moment. */

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  .hello {
    margin-bottom: var(--space-4);
    font-size: var(--text-lg);
    color: var(--text-2);
  }

  .hero h1 {
    max-width: 18ch;
  }

  .sub {
    margin-top: var(--space-4);
    font-size: var(--text-lg);
    color: var(--text-3);
    max-width: var(--measure-narrow);
  }

  .role {
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-3);
  }

  .meta {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-3);
  }

  /* Portrait. Present, not dominant — the work is the headline. */
  .hero-portrait {
    position: relative;
    width: fit-content;
    justify-self: start;
  }

  .hero-portrait img {
    width: clamp(112px, 22vw, 220px);
    height: clamp(112px, 22vw, 220px);
    object-fit: cover;
    border-radius: var(--hoo-r-card);
    border: 1px solid var(--border);
  }

  /* An illustrated portrait on flat teal, shown in colour. It is imagery, not
     interface colour: cyan is still the only accent. */

  /* Below 52rem it leads, as a profile picture does. Above, it sits opposite
     the headline and the DOM order is the reading order again. */
  .hero-portrait {
    order: -1;
  }

  @media (min-width: 52rem) {
    .hero-grid {
      grid-template-columns: 1fr auto;
      gap: var(--space-16);
    }
    .hero-portrait {
      order: 0;
      justify-self: end;
    }
  }

  .sec-title {
    margin-bottom: var(--space-8);
  }

  .mail {
    margin: 0;
    font-size: var(--text-lg);
  }

  /* One column, then two. Never auto-fit: four cards in a three-wide row
     leave one stranded. */
  .cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 52rem) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .card-wrap {
    min-width: 0;
  }

  .card-wrap :global(.card) {
    height: 100%;
  }

  .more {
    margin-top: var(--space-8);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
</style>

<script>
  const a = document.getElementById("hero-mail") as HTMLAnchorElement | null;
  if (a?.dataset.u && a.dataset.d) {
    a.href = `mailto:${a.dataset.u}@${a.dataset.d}`;
  }
</script>
