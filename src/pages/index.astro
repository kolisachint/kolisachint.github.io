---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { site, headlines, email, now, track, recognition } from "../site";

const projects = (await getCollection("projects"))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const featured = projects.slice(0, 6);
const rest = projects.length - featured.length;

/* The record band. Every value is derived from `track` and `recognition`, so
   the home page cannot drift from /about and no new fact enters the site by
   the back door. Spelled numbers, to match the voice everywhere else.

   A start year rather than a running total: "since 2008" is the same fact and
   never needs a January edit, where "18 years" would have disagreed with the
   /about headline the moment the year turned. */
const words = ["no", "one", "two", "three", "four", "five", "six"];
const firstYear = Number(track[track.length - 1].period.slice(0, 4));
const current = track[0];

const record = [
  {
    label: "Experience",
    value: `Since ${firstYear}`,
    note: "enterprise data",
  },
  {
    label: "Employers",
    value: words[track.length].replace(/^./, (c) => c.toUpperCase()),
    note: "banking · retail · telecoms",
  },
  {
    label: "Recognition",
    value: `${words[recognition.length].replace(/^./, (c) => c.toUpperCase())} industry awards`,
    note: recognition.map((r) => r.year).join(" · "),
  },
  {
    label: "Current",
    value: "Google Cloud data platform",
    note: current.client,
  },
];
---

<!-- Written out rather than composed: site.role already carries an em dash,
     and two of them in one <title> reads as a mistake. -->
<BaseLayout
  title={`${site.name} — solution architect, cloud data platforms`}
  suffix={false}
>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-text" data-hero>
        <p class="label">{site.role}</p>
        <h1>{headlines.home}</h1>
        <p class="sub">{headlines.homeSub}</p>

        <div class="actions">
          <a class="btn primary" href="/work">See the work</a>
          <a class="btn" href="/about">About</a>
        </div>
      </div>

      <div class="hero-portrait">
        <img
          src="/img/sachin-koli.jpg"
          alt={site.name}
          width="220"
          height="220"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- The h1 claims two things and the page used to evidence only the second.
       A recruiter has thirty seconds and should not have to click through to
       /about to find the first eighteen years. -->
  <section class="record">
    <div class="shell">
      <h2 class="visually-hidden">Career record</h2>
      <dl class="record-grid">
        {
          record.map((fact, i) => (
            <div class="fact" data-reveal style={`--reveal-delay:${i * 60}ms`}>
              <dt class="label">{fact.label}</dt>
              <dd class="fact-value">{fact.value}</dd>
              <dd class="fact-note mono">{fact.note}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <Section eyebrow="Now" tight>
    <p class="now" data-reveal>{now.text}</p>
    <p class="now-stamp mono" data-reveal>Updated {now.updated}</p>
  </Section>

  <Section eyebrow="Selected work">
    <div class="sec-head" data-reveal>
      <h2>Things I build in the open</h2>
      <p class="lede">
        Tooling for coding agents, mostly in Rust and TypeScript. Small binaries
        that do one thing, and the runtimes that stitch them together.
      </p>
    </div>

    <div class="cards">
      {featured.map((project, i) => (
        <div class="card-wrap" data-reveal style={`--reveal-delay:${i * 60}ms`}>
          <ProjectCard project={project} />
        </div>
      ))}
    </div>

    <p class="more" data-reveal>
      <a class="link" href="/work"
        >All work{rest > 0 && <span>, including {rest} more</span>} &rarr;</a
      >
    </p>
  </Section>

  <Section eyebrow="Contact" tight>
    <div class="sec-head" data-reveal>
      <h2>Reachable</h2>
      <p class="lede">
        Email is best. I read everything, and reply to anything that is not a
        template.
      </p>
    </div>

    <!-- Email only. The same five profile links sat a hundred pixels below
         this list, in the footer, on every page. -->
    <p class="mail" data-reveal>
      <a class="link" id="hero-mail" href="#" data-u={email.user} data-d={email.domain}>
        <span class="mono">{email.user}<span aria-hidden="true">&#64;</span>{email.domain}</span>
      </a>
    </p>
  </Section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding-block: clamp(var(--space-16), 12vh, var(--space-32))
      var(--space-16);
  }

  /* No glow orb here, and no node on the portrait either. Cyan is emphasis,
     not atmosphere: in a real 1440x900 viewport the portrait node, the primary
     button and the masthead's current-page dot were all lit at once. The
     button is the one this viewport keeps. */

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  .hero-text > .label {
    margin-bottom: var(--space-6);
  }

  .hero h1 {
    max-width: 18ch;
  }

  .sub {
    margin-top: var(--space-6);
    font-size: var(--text-lg);
    color: var(--text-3);
    max-width: var(--measure-narrow);
  }

  /* Buttons are global now — see .btn in global.css. */
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  /* Portrait. Present, not dominant — the work is the headline. */
  .hero-portrait {
    position: relative;
    width: fit-content;
    justify-self: start;
  }

  .hero-portrait img {
    /* 96px at 390 — a portrait, not the orphaned square that used to sit
       alone between the buttons and the spine. */
    width: clamp(96px, 22vw, 220px);
    height: clamp(96px, 22vw, 220px);
    object-fit: cover;
    border-radius: var(--hoo-r-card);
    border: 1px solid var(--border);
    filter: grayscale(1) contrast(1.02);
    transition: filter 420ms var(--ease);
  }

  .hero-portrait:hover img {
    filter: grayscale(0) contrast(1);
  }

  /* Below 52rem it leads, as a profile picture does. Above, it sits opposite
     the headline and the DOM order is the reading order again. */
  .hero-portrait {
    order: -1;
  }

  @media (min-width: 52rem) {
    .hero-grid {
      grid-template-columns: 1fr auto;
      gap: var(--space-16);
    }
    .hero-portrait {
      order: 0;
      justify-self: end;
    }
  }

  /* -- Record band ------------------------------------------------------ */

  .record .shell {
    padding-block: var(--space-8);
    border-block: 1px solid var(--border);
  }

  /* Subgrid, so a value that wraps to two lines does not push its own note
     out of line with the other three. Label, value, note are three shared
     rows, not three independent stacks. */
  .record-grid {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: auto;
    gap: var(--space-6) var(--space-8);
  }

  .fact {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-2);
  }

  .fact dd {
    margin: 0;
  }

  .fact-value {
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--text-2);
    text-wrap: balance;
  }

  .fact-note {
    font-size: var(--text-xs);
    color: var(--text-3);
    align-self: end;
  }

  /* Two, then four. Never three — a four-item row that wraps to 3 + 1 reads
     as a mistake. */
  @media (min-width: 34rem) {
    .record-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 60rem) {
    .record-grid {
      grid-template-columns: repeat(4, 1fr);
      grid-template-rows: auto 1fr auto;
    }

    .fact {
      grid-row: span 3;
      grid-template-rows: subgrid;
    }
  }

  .now {
    font-size: var(--text-lg);
    color: var(--text-2);
    max-width: var(--measure);
  }

  .now-stamp {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--text-3);
  }

  .sec-head {
    max-width: var(--measure);
    margin-bottom: var(--space-8);
  }

  .lede {
    margin-top: var(--space-4);
    color: var(--text-3);
  }

  .mail {
    margin: 0;
    font-size: var(--text-lg);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--card-min)), 1fr));
    gap: var(--space-4);
  }

  .card-wrap {
    min-width: 0;
  }

  .card-wrap :global(.card) {
    height: 100%;
  }

  .more {
    margin-top: var(--space-8);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
</style>

<script>
  const a = document.getElementById("hero-mail") as HTMLAnchorElement | null;
  if (a?.dataset.u && a.dataset.d) {
    a.href = `mailto:${a.dataset.u}@${a.dataset.d}`;
  }
</script>
