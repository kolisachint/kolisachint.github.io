---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { headlines } from "../../site";
import { getRepos, tail } from "../../lib/github";

const entries = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);

const projects = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);

const { repos, live } = await getRepos();
const more = tail(repos);
---

<BaseLayout
  title="Work"
  description="Four open-source tools, all in Rust: a terminal coding agent, a local search engine, compact web fetch for agents, and offline speech-to-text."
>
  <header class="page-head">
    <div class="shell" data-hero>
      <p class="label">Work</p>
      <h1>{headlines.work}</h1>
    </div>
  </header>

  {/* Short and scannable, 2026-10-22. Each card says who the tool helps and
      how to get it; the story behind it is folded away for whoever wants it. */}
  <Section eyebrow={`The four · ${projects.length}`}>
    <ol class="projects">
      {
        projects.map(({ entry, Content }) => (
          <li data-reveal>
            <ProjectCard project={entry} level={2}>
              <details class="why">
                <summary><span class="mono">why it exists</span></summary>
                <div class="prose body">
                  <Content />
                </div>
              </details>
            </ProjectCard>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section eyebrow="Also on GitHub">
    <details class="tail-wrap">
      <summary>
        <span class="tail-sum">Everything else, one line each</span>
        <span class="mono tail-count">{more.length} repositories</span>
      </summary>

      <ul class="tail">
        {
          more.map((r) => (
            <li>
              <a class="tail-row" href={r.url}>
                <span class="tail-name mono">{r.name}</span>
                <span class="tail-desc">{r.description}</span>
                <span class="tail-lang mono">{r.lang ?? "—"}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="source-note mono">
        {live ? "Read from the GitHub API at build time" : "From the last snapshot"}.
        Any repository of mine with a description lands here.
      </p>
    </details>
  </Section>
</BaseLayout>

<style>
  .page-head {
    padding-block: var(--space-16) var(--space-8);
  }

  .page-head .label {
    margin-bottom: var(--space-6);
  }

  .page-head h1 {
    max-width: 20ch;
  }

  .projects {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  /* A grid item will not shrink below its content by default, and the
     install line is one long unbreakable string. Without this the card
     pushed the page sideways at 390px. */
  .projects > li {
    min-width: 0;
  }

  /* -- The disclosure ----------------------------------------------------
     A bare text toggle, not a bordered panel: a bordered panel inside every
     bordered entry is a page made of boxes. */
  .why {
    margin-top: calc(-1 * var(--space-2));
  }

  .why summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--control-h-sm);
    font-size: var(--text-xs);
    color: var(--text-3);
    cursor: pointer;
    list-style: none;
    transition: color var(--dur) var(--ease);
  }

  .why summary::-webkit-details-marker {
    display: none;
  }

  .why summary:hover {
    color: var(--text);
  }

  /* Drawn, not a glyph: a font's triangle sits off the optical centre. */
  .why summary::before {
    content: "";
    width: 6px;
    height: 6px;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: rotate(-45deg);
    transition: transform var(--dur) var(--ease);
  }

  .why[open] summary::before {
    transform: rotate(45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .why summary::before {
      transition: none;
    }
  }

  .body {
    margin-top: var(--space-4);
    color: var(--text-3);
  }

  .body :global(p + p) {
    margin-top: var(--space-4);
  }

  .body :global(a) {
    color: var(--text-2);
    text-decoration: underline;
    text-decoration-color: var(--text-3);
    text-underline-offset: 0.22em;
  }

  .body :global(a:hover) {
    color: var(--accent-ink);
  }

  .tail-wrap summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    min-height: var(--control-h-sm);
    cursor: pointer;
    color: var(--text-2);
  }

  .tail-wrap summary::-webkit-details-marker {
    display: none;
  }

  .tail-wrap summary {
    list-style: none;
  }

  .tail-wrap summary::before {
    content: "";
    align-self: center;
    width: 6px;
    height: 6px;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: rotate(-45deg);
  }

  .tail-wrap[open] summary::before {
    transform: rotate(45deg);
  }

  .tail-wrap summary:hover {
    color: var(--text);
  }

  .tail-count {
    font-size: var(--text-xs);
    color: var(--text-3);
  }

  .tail-wrap[open] .tail {
    margin-top: var(--space-6);
  }

  .tail {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--border-strong);
  }

  .tail-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-1) var(--space-6);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--border);
    color: var(--text-3);
    transition: background var(--dur) var(--ease);
  }

  .tail-row:hover {
    background: var(--surface);
    color: var(--text-2);
  }

  .tail-name {
    color: var(--text);
    font-size: var(--text-sm);
  }

  /* GitHub descriptions run from six words to forty. Unclamped, the rows
     ranged from one line to four and the column read as rubble; the row is a
     link to the repository, which has the full sentence. */
  .tail-desc {
    font-size: var(--text-sm);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .tail-lang {
    font-size: var(--text-xs);
    color: var(--text-3);
  }

  @media (min-width: 46rem) {
    .tail-row {
      grid-template-columns: 13rem 1fr 7rem;
      align-items: baseline;
      padding-inline: var(--space-3);
      margin-inline: calc(-1 * var(--space-3));
      border-radius: var(--hoo-r-badge);
    }
    .tail-lang {
      text-align: right;
    }
  }

  .source-note {
    margin-top: var(--space-6);
    font-size: var(--text-xs);
    color: var(--text-3);
  }
</style>
