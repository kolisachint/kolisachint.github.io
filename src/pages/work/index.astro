---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import { headlines } from "../../site";
import { getRepos, tail } from "../../lib/github";

const entries = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);

const projects = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);

const { repos, live } = await getRepos();
const more = tail(repos);
---

<BaseLayout
  title="Work"
  description="Four open-source tools — a terminal coding agent, an embedding search engine, token-efficient web fetch, and offline speech recognition. Rust and TypeScript."
>
  <header class="page-head">
    <div class="shell" data-hero>
      <p class="label">Work</p>
      <h1>{headlines.work}</h1>

      <p class="intro">
        All four are open source and free to use. Each one below says what it
        does, and — if you want the longer answer — why it exists at all.
      </p>
    </div>
  </header>

  <Section eyebrow={`The four · ${projects.length}`}>
    <ol class="projects">
      {
        projects.map(({ entry, Content }) => (
          <li class="project" id={entry.id} data-reveal>
            <div class="project-head">
              <h2>
                <a class="title-link" href={entry.data.repo}>
                  {entry.data.title}
                </a>
              </h2>
              <span class="node" aria-hidden="true" />
            </div>

            <p class="tagline">{entry.data.tagline}</p>

            <p class="meta mono">
              <span class="lang">{entry.data.lang}</span>
              <span class="sep" aria-hidden="true">
                ·
              </span>
              <span>{entry.data.status}</span>
              <span class="sep" aria-hidden="true">
                ·
              </span>
              <a class="out" href={entry.data.repo}>
                source
              </a>
              {entry.data.npm && (
                <>
                  <span class="sep" aria-hidden="true">
                    ·
                  </span>
                  <a class="out" href={entry.data.npm}>
                    npm
                  </a>
                </>
              )}
              {entry.data.site && (
                <>
                  <span class="sep" aria-hidden="true">
                    ·
                  </span>
                  <a class="out" href={entry.data.site}>
                    site
                  </a>
                </>
              )}
            </p>

            {/* Title, tagline and facts say what the thing is in four lines.
                The story behind it is worth reading but nobody should have to
                scroll past four of them to reach the next name. */}
            <details class="why">
              <summary><span class="mono">why it exists</span></summary>
              <div class="prose body">
                <Content />
              </div>
            </details>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section eyebrow="Also on GitHub">
    <div class="tail-head" data-reveal>
      <h2>Everything else, in one line each</h2>
      <p class="lede">
        Other tools, experiments and half-finished ideas — including a few I am
        fond of. The list builds itself: any repository of mine with a
        description lands here, and one without a description does not. Have a
        dig around.
      </p>
    </div>

    <p class="tail-legend mono" aria-hidden="true">
      <span>Repository</span>
      <span>Description</span>
      <span class="tail-lang">Language</span>
    </p>

    <ul class="tail">
      {
        more.map((r) => (
          <li>
            <a class="tail-row" href={r.url}>
              <span class="tail-name mono">{r.name}</span>
              <span class="tail-desc">{r.description}</span>
              <span class="tail-lang mono">{r.lang ?? "—"}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="source-note mono">
      {more.length} repositories ·{" "}
      {live ? "read from the GitHub API at build time" : "from the last snapshot"}
    </p>
  </Section>
</BaseLayout>

<style>
  .page-head {
    padding-block: var(--space-16) var(--space-8);
  }

  .page-head .label {
    margin-bottom: var(--space-6);
  }

  .page-head h1 {
    max-width: 20ch;
  }

  /* The jump-to-project chips went with the five entries they were built for.
     Four headings fit on one screen at most sizes; an index of four is
     furniture. */
  .page-head .intro {
    margin-top: var(--space-6);
    max-width: var(--measure);
    color: var(--text-3);
  }

  .projects {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .project + .project {
    margin-top: var(--space-8);
    padding-top: var(--space-8);
    border-top: 1px solid var(--border);
  }

  /* Arriving from the jump nav, clear the sticky masthead plus the rule. */
  .project {
    scroll-margin-top: calc(var(--masthead-h) + var(--space-12));
  }

  /* Landing on an entry should say so, then get out of the way. */
  .project:target .node {
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent-glow);
  }

  .project-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .project h2 {
    font-size: var(--text-xl);
  }

  .title-link:hover {
    color: var(--accent-ink);
  }

  .node {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--border-strong);
    transition: background var(--dur) var(--ease);
  }

  .project:hover .node {
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent-glow);
  }

  .tagline {
    margin-top: var(--space-2);
    color: var(--text-2);
    max-width: var(--measure);
  }

  /* -- The disclosure ----------------------------------------------------
     A bare text toggle, not a bordered panel: a bordered panel inside every
     bordered entry is a page made of boxes. */
  .why {
    margin-top: var(--space-4);
  }

  .why summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--control-h-sm);
    font-size: var(--text-xs);
    color: var(--text-3);
    cursor: pointer;
    list-style: none;
    transition: color var(--dur) var(--ease);
  }

  .why summary::-webkit-details-marker {
    display: none;
  }

  .why summary:hover {
    color: var(--text);
  }

  /* Drawn, not a glyph: a font's triangle sits off the optical centre. */
  .why summary::before {
    content: "";
    width: 6px;
    height: 6px;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: rotate(-45deg);
    transition: transform var(--dur) var(--ease);
  }

  .why[open] summary::before {
    transform: rotate(45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .why summary::before {
      transition: none;
    }
  }

  .body {
    margin-top: var(--space-4);
    color: var(--text-3);
  }

  .body :global(p + p) {
    margin-top: var(--space-4);
  }

  .body :global(a) {
    color: var(--text-2);
    text-decoration: underline;
    text-decoration-color: var(--text-3);
    text-underline-offset: 0.22em;
  }

  .body :global(a:hover) {
    color: var(--accent-ink);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-6);
    font-size: var(--text-xs);
    color: var(--text-3);
  }

  .lang {
    color: var(--text-3);
  }

  .sep {
    opacity: 0.5;
  }

  .out {
    color: var(--text-3);
    text-decoration: underline;
    text-decoration-color: var(--text-3);
    text-underline-offset: 0.25em;
  }

  .out:hover {
    color: var(--accent-ink);
  }

  .tail-head {
    max-width: var(--measure);
    margin-bottom: var(--space-8);
  }

  .lede {
    margin-top: var(--space-4);
    color: var(--text-3);
  }

  /* Three unlabelled columns of repository, sentence and language. The legend
     is decoration over a list of links, so it is hidden from the accessibility
     tree — a screen reader gets the link text, which already reads in order. */
  .tail-legend {
    display: none;
  }

  .tail {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--border-strong);
  }

  .tail-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-1) var(--space-6);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--border);
    color: var(--text-3);
    transition: background var(--dur) var(--ease);
  }

  .tail-row:hover {
    background: var(--surface);
    color: var(--text-2);
  }

  .tail-name {
    color: var(--text);
    font-size: var(--text-sm);
  }

  /* GitHub descriptions run from six words to forty. Unclamped, the rows
     ranged from one line to four and the column read as rubble; the row is a
     link to the repository, which has the full sentence. */
  .tail-desc {
    font-size: var(--text-sm);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .tail-lang {
    font-size: var(--text-xs);
    color: var(--text-3);
  }

  @media (min-width: 46rem) {
    .tail-legend {
      display: grid;
      grid-template-columns: 13rem 1fr 7rem;
      gap: var(--space-6);
      margin: 0 0 var(--space-2);
      padding-inline: var(--space-3);
      font-size: var(--text-xs);
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
      color: var(--text-3);
    }

    .tail-row {
      grid-template-columns: 13rem 1fr 7rem;
      align-items: baseline;
      padding-inline: var(--space-3);
      margin-inline: calc(-1 * var(--space-3));
      border-radius: var(--hoo-r-badge);
    }
    .tail-lang {
      text-align: right;
    }
  }

  .source-note {
    margin-top: var(--space-6);
    font-size: var(--text-xs);
    color: var(--text-3);
  }
</style>
