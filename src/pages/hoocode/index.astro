---
import DocsLayout from "../../layouts/DocsLayout.astro";

/**
 * Deliberately not upstream's index.md, which is a list of links to the other
 * pages — the sidebar already does that job, and now that the landing renders
 * inside the same two-pane shell it does it here too. This page is the entry
 * point: what the thing is, how to install it, and what it looks like running.
 */
/**
 * The ways in, in the order most people want them. The script needs nothing
 * installed first; npm and pip suit people who already have Node or Python.
 * Release archives and source builds are on /hoocode/install.
 *
 * /hoocode/install.sh is a verbatim copy of install/install.sh in
 * kolisachint/hoocode, kept in step by `npm run docs`. The host comes from
 * `site` in astro.config.mjs, so a custom domain does not need an edit here.
 * There is no Windows build; the TypeScript build that used to cover Windows
 * was retired on 2026-10-10.
 */
const installs = new URL("/hoocode", Astro.site).href;

const INSTALLS = [
  {
    id: "unix",
    label: "macOS / Linux",
    cmd: `curl -fsSL ${installs}/install.sh | sh`,
  },
  {
    id: "npm",
    label: "npm / bun · Node 18+",
    cmd: "npm install -g @kolisachint/hoocode",
  },
  {
    id: "pip",
    label: "pip · Python 3.8+",
    cmd: "pip install hoocode",
  },
];

const modes = [
  { name: "Ask", note: "read and answer, no edits" },
  { name: "Plan", note: "explore and write a plan" },
  { name: "Build", note: "implement and verify, one change at a time" },
  { name: "Debug", note: "find the root cause, no edits" },
];
---

<DocsLayout
  id="index"
  landing
  title="HooCode — a terminal coding agent, written in Rust"
  description="HooCode is a terminal coding agent written in Rust: one native binary for macOS and Linux, any model provider, and nothing applied without your approval."
>
  <div class="lead">
    {/* Not <picture> with prefers-color-scheme: the toggle sets data-theme,
        so the media query would disagree with it the moment anyone switches
        against their OS. Both marks ship; CSS picks. They are ~4 KB each. */}
    <div class="lockup">
      <img class="on-dark" src="/brand/hoo/hoocode.svg" alt="HooCode" width="274" height="80" />
      <img class="on-light" src="/brand/hoo/hoocode-light.svg" alt="" aria-hidden="true" width="274" height="80" />
    </div>

    <h1>A terminal coding agent, written in Rust.</h1>

    <p class="sub">
      One native binary, any model provider. Shell, Edit and Write ask before
      they run, and four modes keep the agent to what the job needs.
    </p>

    <div class="install">
      <p class="label" id="install-label">Install</p>
      {
        INSTALLS.map((install) => (
          <div class="install-row">
            <p class="platform mono" id={`install-${install.id}`}>{install.label}</p>
            <div class="cmd-row">
              <pre class="cmd" aria-labelledby={`install-${install.id}`}><code>{install.cmd}</code></pre>
              <button class="copy mono" type="button" data-copy={install.cmd}>
                <span data-copy-label>Copy</span>
              </button>
            </div>
          </div>
        ))
      }
      <p class="cmd-note mono">
        no root needed · then run <code>hoocode</code> in a project directory ·{" "}
        <a href="/hoocode/install">all install options</a>
      </p>
      <p class="visually-hidden" role="status" data-copy-status></p>
    </div>

    <div class="actions">
      <a class="btn primary" href="/hoocode/quickstart">Quickstart</a>
      <a class="btn" href="https://github.com/kolisachint/hoocode">GitHub</a>
      <a class="btn" href="https://www.npmjs.com/package/@kolisachint/hoocode">npm</a>
    </div>
  </div>

  <section class="block">
    <h2 class="label">Modes</h2>
    <div class="modes">
      {
        modes.map((m) => (
          <div class="mode">
            <p class="mode-name mono">{m.name}</p>
            <p class="mode-note">{m.note}</p>
          </div>
        ))
      }
    </div>
  </section>

</DocsLayout>

<style>
  /* -- Lead --------------------------------------------------------------- */

  .lockup {
    display: grid;
    width: fit-content;
  }

  .lockup img {
    grid-area: 1 / 1;
    height: 40px;
    width: auto;
  }

  :global([data-theme="dark"]) .on-light,
  :global([data-theme="light"]) .on-dark {
    visibility: hidden;
  }

  .lead h1 {
    margin-top: var(--space-6);
    font-size: var(--text-2xl);
    max-width: 16ch;
  }

  .sub {
    margin-top: var(--space-4);
    color: var(--text-3);
    max-width: var(--measure-narrow);
  }

  /* -- Install ------------------------------------------------------------ */

  .install {
    margin-top: var(--space-8);
    max-width: 34rem;
  }

  .install .label {
    margin-bottom: var(--space-4);
  }

  /* Rows share the block's measure so the three commands line up, which is what
     makes them read as one choice rather than three instructions. */
  .install-row + .install-row {
    margin-top: var(--space-4);
  }

  .platform {
    margin-bottom: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-3);
  }

  .cmd-row {
    display: flex;
    align-items: stretch;
    gap: var(--space-2);
  }

  .cmd {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    align-items: center;
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--hoo-r-badge);
    background: var(--surface);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text);
  }

  .copy {
    flex: none;
    min-width: 5.5rem;
    padding-inline: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--hoo-r-badge);
    background: transparent;
    color: var(--text-3);
    font-size: var(--text-xs);
    cursor: pointer;
    transition:
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease),
      background var(--dur) var(--ease);
  }

  .copy:hover {
    border-color: var(--border-strong);
    background: var(--surface);
    color: var(--text);
  }

  .copy[data-done] {
    color: var(--accent-ink);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }

  /* No clipboard API, no button. The command is selectable either way. */
  .copy[hidden] {
    display: none;
  }

  /* Narrow screens: stack, and let the command wrap rather than hide its own
     tail behind a scroll nobody discovers. */
  @media (max-width: 30rem) {
    .cmd-row {
      flex-direction: column;
      align-items: stretch;
    }

    .cmd {
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      overflow-x: visible;
    }

    .copy {
      min-height: 40px;
    }
  }

  .cmd-note {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--text-3);
  }

  .cmd-note code {
    color: var(--text-3);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  /* -- Blocks ------------------------------------------------------------- */

  .block {
    margin-top: var(--space-16);
  }

  .block > .label {
    margin-bottom: var(--space-4);
  }

  /* Explicit counts, not auto-fit: four cells in a three-wide grid leaves one
     empty, and with the hairline-gap technique an empty cell is a visible
     grey rectangle. 1 → 2 → 4 always divides. */
  .modes {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--hoo-r-card);
    overflow: hidden;
  }

  @media (min-width: 34rem) {
    .modes {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Only once the shell is wide enough that the sidebar has stopped taking
     it out of the pane. */
  @media (min-width: 86rem) {
    .modes {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .mode {
    padding: var(--space-5) var(--space-6);
    background: var(--bg);
  }

  .mode-name {
    color: var(--text);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  /* The cursor from the HooCode lockup, used as the mode's tick. */
  .mode-name::after {
    content: "_";
    color: var(--accent);
    margin-left: 2px;
  }

  .mode-note {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--text-3);
  }

</style>

<script>
  // Copy-to-clipboard for the install lines. Progressive: the buttons are
  // removed outright where the API is unavailable, rather than left there to
  // fail. One shared status region and one shared timer, so copying a second
  // command resets the first button instead of leaving two reading "Copied".
  const buttons = document.querySelectorAll<HTMLButtonElement>(".copy");
  const status = document.querySelector<HTMLElement>("[data-copy-status]");

  if (!navigator.clipboard) {
    for (const btn of buttons) btn.hidden = true;
  } else {
    let timer: number | undefined;

    const reset = () => {
      for (const btn of buttons) {
        const label = btn.querySelector<HTMLElement>("[data-copy-label]");
        if (label) label.textContent = "Copy";
        delete btn.dataset.done;
      }
      if (status) status.textContent = "";
    };

    for (const btn of buttons) {
      btn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.copy ?? "");
        } catch {
          return;
        }
        reset();
        const label = btn.querySelector<HTMLElement>("[data-copy-label]");
        if (label) label.textContent = "Copied";
        btn.dataset.done = "";
        if (status) status.textContent = "Install command copied.";

        clearTimeout(timer);
        timer = window.setTimeout(reset, 1600);
      });
    }
  }
</script>
