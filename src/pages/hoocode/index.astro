---
import DocsLayout from "../../layouts/DocsLayout.astro";

/**
 * Deliberately not upstream's index.md, which is a list of links to the other
 * pages — the sidebar already does that job, and now that the landing renders
 * inside the same two-pane shell it does it here too. This page is the entry
 * point: what the thing is, how to install it, and what it looks like running.
 */
/**
 * Three ways in, in the order most people want them.
 *
 * The one-liners come first because they need nothing installed first — the npm
 * line, which was the only option here, quietly asks the reader to already have
 * Node, and the people most likely to bounce off this page are exactly the ones
 * who do not.
 *
 * The scripts they fetch are vendored to public/hoocode by scripts/sync-docs.mjs
 * from install/ in the hoocode repository, so these URLs are stable and the file
 * served is byte-identical to the one reviewed there. The host comes from `site`
 * in astro.config.mjs, so a custom domain does not need an edit here.
 */
const installs = new URL("/hoocode", Astro.site).href;

const INSTALLS = [
  {
    id: "unix",
    label: "macOS / Linux",
    cmd: `curl -fsSL ${installs}/install.sh | sh`,
  },
  {
    id: "windows",
    label: "Windows",
    cmd: `irm ${installs}/install.ps1 | iex`,
  },
  {
    id: "npm",
    label: "npm · Node 20+",
    cmd: "npm install -g @kolisachint/hoocode-agent",
  },
];

const modes = [
  { name: "Ask", note: "answer, do not touch the repository" },
  { name: "Plan", note: "investigate and propose, no edits" },
  { name: "Build", note: "implement, one step at a time" },
  { name: "Debug", note: "reproduce, isolate, fix" },
];
---

<DocsLayout
  id="index"
  landing
  title="HooCode — deterministic terminal coding agent"
  description="HooCode is a deterministic terminal coding agent — four scoped modes (Ask · Plan · Build · Debug), 25+ providers, hybrid search, and one-click plugins in a single binary."
>
  <div class="lead">
    {/* Not <picture> with prefers-color-scheme: the toggle sets data-theme,
        so the media query would disagree with it the moment anyone switches
        against their OS. Both marks ship; CSS picks. They are ~4 KB each. */}
    <div class="lockup">
      <img class="on-dark" src="/brand/hoo/hoocode.svg" alt="HooCode" width="274" height="80" />
      <img class="on-light" src="/brand/hoo/hoocode-light.svg" alt="" aria-hidden="true" width="274" height="80" />
    </div>

    <h1>Deterministic terminal coding agent.</h1>

    <p class="sub">
      Four scoped modes, 25+ providers, hybrid search, and one-click plugins in
      a single binary. Nothing applies without your approval.
    </p>

    <div class="install">
      <p class="label" id="install-label">Install</p>
      {
        INSTALLS.map((install) => (
          <div class="install-row">
            <p class="platform mono" id={`install-${install.id}`}>{install.label}</p>
            <div class="cmd-row">
              <pre class="cmd" aria-labelledby={`install-${install.id}`}><code>{install.cmd}</code></pre>
              <button class="copy mono" type="button" data-copy={install.cmd}>
                <span data-copy-label>Copy</span>
              </button>
            </div>
          </div>
        ))
      }
      <p class="cmd-note mono">
        no root needed · then run <code>hoocode</code> in a project directory ·
        <a href="/hoocode/install">all install options</a>
      </p>
      <p class="visually-hidden" role="status" data-copy-status></p>
    </div>

    <div class="actions">
      <a class="btn primary" href="/hoocode/quickstart">Quickstart</a>
      <a class="btn" href="https://github.com/kolisachint/hoocode">GitHub</a>
      <a class="btn" href="https://www.npmjs.com/package/@kolisachint/hoocode-agent">npm</a>
    </div>
  </div>

  <section class="block">
    <h2 class="label">Modes</h2>
    <div class="modes">
      {
        modes.map((m) => (
          <div class="mode">
            <p class="mode-name mono">{m.name}</p>
            <p class="mode-note">{m.note}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="block">
    <h2 class="label">Demo</h2>

    {/* Click-to-play, never autoplay: 9 MB is not a background texture, and
        preload="none" means it costs the poster until asked for. Capped well
        under the width of the pane — a recording of a terminal does not get
        more legible by being stretched, it just stops looking deliberate.

        The poster is frame 0 of the recording itself (`bin/site poster`): an
        opened session, one empty prompt, nothing else. A frame lifted from the
        middle looked busy before anyone had pressed play, and it advertised a
        state the video does not start in. */}
    <figure class="demo">
      {/* `controls` ships in the markup so the video is playable with no
          JavaScript at all. The script below takes them away and puts the
          overlay up instead — the browser's own grey control bar was the
          largest object on this page and the only one not in the design
          system. Controls come back the moment it starts playing. */}
      <div class="frame">
        <video
          src="/hoocode/demo.mp4"
          poster="/hoocode/demo-poster.webp"
          controls
          preload="none"
          playsinline
          aria-label="HooCode demo recording"
          aria-describedby="demo-caption"
        />
        <button class="play" type="button" hidden aria-label="Play the HooCode demo">
          <span class="disc" aria-hidden="true"></span>
        </button>
      </div>
      <figcaption id="demo-caption" class="mono">
        Ask, then Plan, then Build — one session scaffolds a Bun and Hono
        service with tests. 102 seconds, no audio.
      </figcaption>
    </figure>
  </section>
</DocsLayout>

<style>
  /* -- Lead --------------------------------------------------------------- */

  .lockup {
    display: grid;
    width: fit-content;
  }

  .lockup img {
    grid-area: 1 / 1;
    height: 40px;
    width: auto;
  }

  :global([data-theme="dark"]) .on-light,
  :global([data-theme="light"]) .on-dark {
    visibility: hidden;
  }

  .lead h1 {
    margin-top: var(--space-6);
    font-size: var(--text-2xl);
    max-width: 16ch;
  }

  .sub {
    margin-top: var(--space-4);
    color: var(--text-3);
    max-width: var(--measure-narrow);
  }

  /* -- Install ------------------------------------------------------------ */

  .install {
    margin-top: var(--space-8);
    max-width: 34rem;
  }

  .install .label {
    margin-bottom: var(--space-4);
  }

  /* Rows share the block's measure so the three commands line up, which is what
     makes them read as one choice rather than three instructions. */
  .install-row + .install-row {
    margin-top: var(--space-4);
  }

  .platform {
    margin-bottom: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-3);
  }

  .cmd-row {
    display: flex;
    align-items: stretch;
    gap: var(--space-2);
  }

  .cmd {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    align-items: center;
    margin: 0;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--hoo-r-badge);
    background: var(--surface);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text);
  }

  .copy {
    flex: none;
    min-width: 5.5rem;
    padding-inline: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--hoo-r-badge);
    background: transparent;
    color: var(--text-3);
    font-size: var(--text-xs);
    cursor: pointer;
    transition:
      border-color var(--dur) var(--ease),
      color var(--dur) var(--ease),
      background var(--dur) var(--ease);
  }

  .copy:hover {
    border-color: var(--border-strong);
    background: var(--surface);
    color: var(--text);
  }

  .copy[data-done] {
    color: var(--accent-ink);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }

  /* No clipboard API, no button. The command is selectable either way. */
  .copy[hidden] {
    display: none;
  }

  /* Narrow screens: stack, and let the command wrap rather than hide its own
     tail behind a scroll nobody discovers. */
  @media (max-width: 30rem) {
    .cmd-row {
      flex-direction: column;
      align-items: stretch;
    }

    .cmd {
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      overflow-x: visible;
    }

    .copy {
      min-height: 40px;
    }
  }

  .cmd-note {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--text-3);
  }

  .cmd-note code {
    color: var(--text-3);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  /* -- Blocks ------------------------------------------------------------- */

  .block {
    margin-top: var(--space-16);
  }

  .block > .label {
    margin-bottom: var(--space-4);
  }

  /* Explicit counts, not auto-fit: four cells in a three-wide grid leaves one
     empty, and with the hairline-gap technique an empty cell is a visible
     grey rectangle. 1 → 2 → 4 always divides. */
  .modes {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--hoo-r-card);
    overflow: hidden;
  }

  @media (min-width: 34rem) {
    .modes {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Only once the shell is wide enough that the sidebar has stopped taking
     it out of the pane. */
  @media (min-width: 86rem) {
    .modes {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .mode {
    padding: var(--space-5) var(--space-6);
    background: var(--bg);
  }

  .mode-name {
    color: var(--text);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  /* The cursor from the HooCode lockup, used as the mode's tick. */
  .mode-name::after {
    content: "_";
    color: var(--accent);
    margin-left: 2px;
  }

  .mode-note {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--text-3);
  }

  /* -- Demo --------------------------------------------------------------- */

  .demo {
    margin: 0;
    max-width: 34rem;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--hoo-r-card);
    background: var(--surface);
    box-shadow: var(--shadow-2);
  }

  .frame {
    position: relative;
  }

  /* The recording's own ratio, so the poster fills the frame with no bars and
     the space is reserved before it loads. */
  .demo video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1598 / 1080;
  }

  /* The whole poster is the target, which is the largest one available and
     needs no minimum. Scrim and ink come from the media tokens, not the theme
     ones: the poster is a light terminal in both themes, so a disc keyed to
     --bg was near-white on near-white in light. */
  .play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: var(--media-scrim);
    cursor: pointer;
    transition: opacity var(--dur) var(--ease);
  }

  .play:hover {
    opacity: 0.82;
  }

  .disc {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border: 1px solid var(--media-ink);
    border-radius: 50%;
    color: var(--media-ink);
    transition: transform var(--dur) var(--ease);
  }

  /* Drawn from borders — a font's triangle is never on the optical centre. */
  .disc::before {
    content: "";
    margin-left: 3px;
    border-left: 12px solid currentColor;
    border-block: 8px solid transparent;
  }

  .play:hover .disc {
    transform: scale(1.06);
  }

  @media (prefers-reduced-motion: reduce) {
    .play:hover .disc {
      transform: none;
    }
  }

  .demo figcaption {
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-xs);
    color: var(--text-3);
    border-top: 1px solid var(--border);
  }
</style>

<script>
  // The demo frame. Browser controls are in the markup and taken out here, so
  // the no-JavaScript case is a working player rather than a dead poster.
  const demo = document.querySelector<HTMLVideoElement>(".demo video");
  const play = document.querySelector<HTMLButtonElement>(".demo .play");

  if (demo && play) {
    demo.controls = false;
    play.hidden = false;

    const start = () => {
      demo.controls = true;
      play.hidden = true;
    };

    play.addEventListener("click", () => {
      start();
      void demo.play();
    });

    // Played by any other route — keyboard on the element, autoplay policy,
    // a restored session — and the overlay still gets out of the way.
    demo.addEventListener("play", start);
  }

  // Copy-to-clipboard for the install lines. Progressive: the buttons are
  // removed outright where the API is unavailable, rather than left there to
  // fail. One shared status region and one shared timer, so copying a second
  // command resets the first button instead of leaving two reading "Copied".
  const buttons = document.querySelectorAll<HTMLButtonElement>(".copy");
  const status = document.querySelector<HTMLElement>("[data-copy-status]");

  if (!navigator.clipboard) {
    for (const btn of buttons) btn.hidden = true;
  } else {
    let timer: number | undefined;

    const reset = () => {
      for (const btn of buttons) {
        const label = btn.querySelector<HTMLElement>("[data-copy-label]");
        if (label) label.textContent = "Copy";
        delete btn.dataset.done;
      }
      if (status) status.textContent = "";
    };

    for (const btn of buttons) {
      btn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.copy ?? "");
        } catch {
          return;
        }
        reset();
        const label = btn.querySelector<HTMLElement>("[data-copy-label]");
        if (label) label.textContent = "Copied";
        btn.dataset.done = "";
        if (status) status.textContent = "Install command copied.";

        clearTimeout(timer);
        timer = window.setTimeout(reset, 1600);
      });
    }
  }
</script>
