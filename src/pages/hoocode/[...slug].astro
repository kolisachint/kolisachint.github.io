---
import { getCollection, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { titleFor, isListed, summarise } from "../../lib/docs";

/**
 * Every vendored page except `index`. The overview lives at
 * src/pages/hoocode/index.astro instead — upstream's index.md is a list of
 * links to the other pages, which the sidebar already is.
 */
export async function getStaticPaths() {
  const entries = await getCollection("docs");
  return entries
    .filter((entry) => entry.id !== "index")
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const h1 = headings.find((h) => h.depth === 1);
const title = titleFor(entry.id, h1?.text ?? entry.id);
const description = summarise(entry.body ?? "");
---

<DocsLayout
  id={entry.id}
  title={title}
  description={description}
  headings={headings}
  listed={isListed(entry.id)}
>
  <Content />
</DocsLayout>
