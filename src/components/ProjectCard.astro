---
/**
 * One project, readable in a few seconds: the name, one line on who it helps
 * and what it solves, then how to get it. Home and /work both use this, so the
 * two pages cannot drift apart. /work passes the longer story in the slot,
 * folded behind a disclosure.
 */
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  /** Heading level for the title, so each page keeps its outline. */
  level?: 2 | 3;
}

const { project, level = 3 } = Astro.props;
const { title, tagline, lang, repo, npm, docs, install, download } = project.data;
const H = `h${level}` as "h2" | "h3";

/* The install line names the site's own host. It is written as {origin} in
   the content file and filled in here from `site`, so a custom domain is
   still a one-line change in astro.config.mjs. */
const origin = new URL(Astro.site ?? "http://localhost").origin;
const cmd = install?.replaceAll("{origin}", origin);
---

<article class="card" id={project.id}>
  <header class="head">
    <H class="title"><a href={repo}>{title}</a></H>
    <span class="lang mono">{lang}</span>
  </header>

  <p class="tagline">{tagline}</p>

  {
    cmd ? (
      <div class="cmd-row">
        <pre class="cmd" aria-label={`Install ${title}`}><code>{cmd}</code></pre>
        <button class="copy mono" type="button" data-copy={cmd} hidden>
          Copy
        </button>
      </div>
    ) : (
      download && (
        <p class="get">
          <a class="link" href={download}>Download a prebuilt binary</a>
        </p>
      )
    )
  }

  <p class="links mono">
    <a class="out" href={repo}>source</a>
    {docs && <a class="out" href={docs}>docs</a>}
    {npm && <a class="out" href={npm}>npm</a>}
  </p>

  <slot />
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--hoo-r-card);
    background: var(--surface);
    scroll-margin-top: calc(var(--masthead-h) + var(--space-8));
    transition: border-color var(--dur) var(--ease);
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--border-strong);
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .title {
    font-size: var(--text-lg);
    font-weight: 560;
    letter-spacing: var(--tracking-tight);
  }

  .title a:hover {
    color: var(--accent-ink);
  }

  .lang {
    font-size: var(--text-xs);
    color: var(--text-3);
  }

  .tagline {
    color: var(--text-2);
    max-width: var(--measure);
  }

  .cmd-row {
    display: flex;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-2);
  }

  .cmd {
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--hoo-r-badge);
    background: var(--bg);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-2);
  }

  .copy {
    flex: none;
    min-height: var(--control-h-sm);
    padding-inline: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--hoo-r-badge);
    background: transparent;
    color: var(--text-3);
    font-size: var(--text-xs);
    cursor: pointer;
  }

  .copy:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }

  .get {
    margin-top: auto;
    padding-top: var(--space-2);
    font-size: var(--text-sm);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    font-size: var(--text-xs);
  }

  .out {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-h-sm);
    color: var(--text-3);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 0.25em;
  }

  .out:hover {
    color: var(--accent-ink);
  }
</style>

<script>
  // Copy buttons ship hidden and appear only where the clipboard API exists,
  // so nobody is shown a button that cannot work.
  if (navigator.clipboard) {
    for (const btn of document.querySelectorAll<HTMLButtonElement>(".card .copy")) {
      btn.hidden = false;
      btn.addEventListener("click", async () => {
        await navigator.clipboard.writeText(btn.dataset.copy ?? "");
        btn.textContent = "Copied";
        setTimeout(() => (btn.textContent = "Copy"), 1500);
      });
    }
  }
</script>
