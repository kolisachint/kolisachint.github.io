---
/**
 * One pinned repository on the home page: name, the GitHub description, the
 * language and topics. The whole card links to the repo's product page.
 */
import type { PinnedRepo } from "../lib/pinned";

interface Props {
  repo: PinnedRepo;
}

const { repo } = Astro.props;
---

<article class="card">
  <header class="head">
    <h3 class="title"><a href={`/${repo.name}/`}>{repo.name}</a></h3>
    {repo.language && <span class="lang mono">{repo.language}</span>}
  </header>

  <p class="desc">{repo.description}</p>

  {
    repo.topics.length > 0 && (
      <ul class="topics mono" aria-label="Topics">
        {repo.topics.slice(0, 5).map((t) => <li>{t}</li>)}
      </ul>
    )
  }
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--hoo-r-card);
    background: var(--surface);
    transition: border-color var(--dur) var(--ease);
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--border-strong);
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .title {
    font-size: var(--text-lg);
    font-weight: 560;
    letter-spacing: var(--tracking-tight);
  }

  /* The title link stretches over the whole card, so it is one target. */
  .title a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--hoo-r-card);
  }

  .card:hover .title a {
    color: var(--accent-ink);
  }

  .lang {
    font-size: var(--text-xs);
    color: var(--text-3);
  }

  .desc {
    color: var(--text-2);
    max-width: var(--measure);
  }

  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: auto;
    padding: 0;
    list-style: none;
    font-size: var(--text-xs);
    color: var(--text-3);
  }

  .topics li {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--hoo-r-badge);
  }
</style>
